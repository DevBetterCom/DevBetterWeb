    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.AzureAppServices" Version="11.0.0" />
