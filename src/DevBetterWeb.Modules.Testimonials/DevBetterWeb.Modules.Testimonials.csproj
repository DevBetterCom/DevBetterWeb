<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>DevBetterWeb.Modules.Testimonials</RootNamespace>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningsAsErrors />
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="DevBetterWeb.Modules.Testimonials.Tests" />
		<!-- Functional tests drive admin-side transitions (e.g. RequestChanges) until the admin UI (#1491) exists. -->
		<InternalsVisibleTo Include="DevBetterWeb.FunctionalTests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DevBetterWeb.Modules.Testimonials.Contracts\DevBetterWeb.Modules.Testimonials.Contracts.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Ardalis.GuardClauses" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
	</ItemGroup>

</Project>
